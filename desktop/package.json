{
  "name": "asgard-codeaudit-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "bundle": "node build.mjs",
    "build": "node build.mjs && tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "node build.mjs && electron dist/main.js",
    "start": "electron dist/main.js",
    "test": "vitest run && node --test tests/lifecycle-startup.test.cjs",
    "test:native": "node tests/run-native-smoke.cjs",
    "test:preview-browser": "electron tests/preview-browser.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.11"
  }
}
